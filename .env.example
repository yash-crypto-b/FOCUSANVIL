# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/focusanvil

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=development

# Gamification Settings
ABORT_PENALTY_COINS=50
SESSION_REWARD_COINS_PER_HOUR=100
STREAK_BREAK_ABORT_THRESHOLD=3

# Timezone
DEFAULT_TIMEZONE=Asia/Kolkata

# Mentor Settings
DAILY_MENTOR_TIME=06:00
